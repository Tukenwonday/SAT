# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://waleed:CHANGE_ME@localhost:5432/satbank
PORT=3001
# Local testing: only DATABASE_URL + PORT matter. CORS defaults to * (allow
# anything) when CORS_ORIGIN is unset, so you can omit it entirely for now.
# Set CORS_ORIGIN to your domain only when deploying publicly later.
# Server timezone for day_key/today counts. Should match the players' locale.
# Example: TZ=Asia/Hebron
TZ=Asia/Hebron
ONLINE_WINDOW_MS=30000
INVITE_TTL_MS=60000
MAX_PRESENCE=30
