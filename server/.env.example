# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://waleed:CHANGE_ME@localhost:5432/satbank
PORT=3001
# Local testing: only DATABASE_URL + PORT matter. CORS defaults to * (allow
# anything) when CORS_ORIGIN is unset, so you can omit it entirely for now.
# In production (frontend on Netlify, API direct on this VPS) set:
# CORS_ORIGIN=https://satbank.netlify.app,https://51-84-109-28.sslip.io
# Set CORS_ORIGIN to your domain only when deploying publicly later.
# Server timezone for day_key/today counts. Should match the players' locale.
# Example: TZ=Asia/Hebron
TZ=Asia/Hebron
# Presence freshness window. Clients heartbeat every ~25s (visible) / ~60s
# (hidden); the window must comfortably exceed that or the roster flickers.
ONLINE_WINDOW_MS=75000
INVITE_TTL_MS=90000
MAX_PRESENCE=30

# Master Admin Password for /admin dashboard
ADMIN_PASSWORD=your_secure_password_here

